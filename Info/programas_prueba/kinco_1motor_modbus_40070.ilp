(*2*)
(* Kinco MK043E-20DT - 1 motor NEMA23 por MODBUS RTU *)
(* Mapa compatible con firmware ESP32 nema23_kinco_modbus_esp32 *)
(* Control 40070/%VW138, estado 40152/%VW302, posicion 40101/%VD200 *)

(* Network 0 - Liberar inhibicion PTO0 *)
LD    %SM0.0
R     %SM201.3

(* Network 1 - POS PABS default *)
LD    %SM0.1
MOVE  DI#0, %VD100

(* Network 2 - MAXF PABS default *)
LD    %SM0.1
MOVE  DW#2000, %VD104

(* Network 3 - MINF PABS default *)
LD    %SM0.1
MOVE  W#300, %VW108

(* Network 4 - TIME PABS default *)
LD    %SM0.1
MOVE  W#300, %VW110

(* Network 5 - MODE HOME default: 1 = solo HOME *)
LD    %SM0.1
MOVE  I#1, %VW112

(* Network 6 - DIRC HOME default: 0 = Forward *)
LD    %SM0.1
MOVE  I#0, %VW114

(* Network 7 - MINF HOME default *)
LD    %SM0.1
MOVE  W#200, %VW116

(* Network 8 - MAXF HOME default *)
LD    %SM0.1
MOVE  DW#1000, %VD118

(* Network 9 - TIME HOME default *)
LD    %SM0.1
MOVE  W#300, %VW122

(* Network 10 - Limpiar ErrID PABS/STOP *)
LD    %SM0.1
MOVE  W#0, %VW304

(* Network 11 - Limpiar ErrID HOME/reservado *)
LD    %SM0.1
MOVE  W#0, %VW306

(* Network 12 - NHOME falso/no usado *)
LD    %SM0.1
R     %M10.0

(* Network 13 - HomeOK inicial apagado *)
LD    %SM0.1
R     %M1.0

(* Network 14 - HomingActive inicial apagado *)
LD    %SM0.1
R     %M1.1

(* Network 15 - PabsActive inicial apagado *)
LD    %SM0.1
R     %M1.2

(* Network 16 - Liberar stop de software al iniciar *)
LD    %SM0.1
R     %SM201.7

(* Network 17 - Enable driver: revisar si la salida cableada es Q0.3 *)
LD    %V138.0
ST    %Q0.3

(* Network 18 - Reset posicion logica PTO0 *)
LD    %V138.1
ST    %SM201.6

(* Network 19 - PSTOP por MODBUS *)
LD    %SM0.0
PSTOP 0, %V138.5, %M5.0, %VB305

(* Network 20 - Liberar stop antes de HOME o PABS *)
LD    %V138.2
OR    %V138.3
R     %SM201.7

(* Network 21 - HOME por MODBUS *)
LD    %V138.0
PHOME 0, %V138.3, %I0.0, %M10.0, %VW112, %VW114, %VW116, %VD118, %VW122, %M3.1, %M3.2, %VB306

(* Network 22 - Set HomeOK si PHOME termina sin error *)
LDN   %M3.2
AND   %M3.1
S     %M1.0

(* Network 23 - Reset HomeOK por reset estados o reset posicion *)
LD    %V138.4
OR    %V138.1
R     %M1.0

(* Network 24 - Auxiliar sin error HOME *)
LDN   %M3.2
ST    %M1.4

(* Network 25 - Auxiliar sin error PABS *)
LDN   %M2.2
ST    %M1.5

(* Network 26 - Sistema listo para PABS *)
LD    %V138.0
AND   %M1.0
AND   %M1.4
AND   %M1.5
ST    %M1.3

(* Network 27 - PABS por MODBUS *)
LD    %M1.3
PABS  0, %V138.2, %VW108, %VD104, %VW110, %VD100, %M2.1, %M2.2, %VB304

(* Network 28 - Set homing activo *)
LD    %V138.3
AND   %V138.0
S     %M1.1

(* Network 29 - Reset homing activo *)
LD    %M3.1
OR    %M3.2
OR    %V138.5
OR    %V138.4
R     %M1.1

(* Network 30 - Set PABS activo *)
LD    %V138.2
AND   %M1.3
S     %M1.2

(* Network 31 - Reset PABS activo *)
LD    %M2.1
OR    %M2.2
OR    %V138.5
OR    %V138.4
R     %M1.2

(* Network 32 - ResetStatus limpia ErrID PABS/STOP *)
LD    %V138.4
MOVE  W#0, %VW304

(* Network 33 - ResetStatus limpia ErrID HOME/reservado *)
LD    %V138.4
MOVE  W#0, %VW306

(* Network 34 - Copiar posicion actual PTO0 a MODBUS *)
LD    %SM0.0
MOVE  %SMD212, %VD200

(* Network 35 - Status bit 0: HomeOK *)
LD    %M1.0
ST    %V302.0

(* Network 36 - Status bit 1: HomeDone *)
LD    %M3.1
ST    %V302.1

(* Network 37 - Status bit 2: HomeErr *)
LD    %M3.2
ST    %V302.2

(* Network 38 - Status bit 3: PabsDone *)
LD    %M2.1
ST    %V302.3

(* Network 39 - Status bit 4: PabsErr *)
LD    %M2.2
ST    %V302.4

(* Network 40 - Status bit 5: PTO0 status *)
LD    %SM66.7
ST    %V302.5

(* Network 41 - Status bit 6: HomingActive *)
LD    %M1.1
ST    %V302.6

(* Network 42 - Status bit 7: PabsActive *)
LD    %M1.2
ST    %V302.7

(* Network 43 - Status bit 8: HomeSensor *)
LD    %I0.0
ST    %V303.0

(* Network 44 - Status bit 9: SystemReady *)
LD    %M1.3
ST    %V303.1

(* Network 45 - Status bit 10: EnableOut *)
LD    %Q0.3
ST    %V303.2

(* Network 46 - Status bit 11: StopDone *)
LD    %M5.0
ST    %V303.3

(* Network 47 - Status bit 12: CtrlEnable espejo *)
LD    %V138.0
ST    %V303.4

(* Network 48 - Status bit 13: CtrlStop espejo *)
LD    %V138.5
ST    %V303.5

END
