VAR_GLOBAL
    Hw_StepPul AT  %Q0.0    :BOOL  ;  (*PTO0 STEP PUL manejado por PABS*)
    Hw_Dir AT  %Q0.2    :BOOL  ;  (*PTO0 DIR manejado por PABS*)
    Err_Pabs AT  %VB304   :BYTE  ;  (*MODBUS 40153 low byte error PABS actual*)
    Err_ReturnReserved AT  %VB306   :BYTE  ;  (*MODBUS 40154 low byte reservado limpiado*)
    Cmd_TargetSteps AT  %VD100   :DINT  ;  (*MODBUS 40051-40052 pasos destino distinto de 0 arranca ciclo*)
    PabsMaxF AT  %VD104   :DWORD ;  (*MODBUS 40053-40054 frecuencia maxima PABS*)
    MoveTarget AT  %VD120   :DINT  ;  (*Copia interna del destino recibido*)
    ReturnTarget AT  %VD124   :DINT  ;  (*Destino interno de vuelta a cero*)
    ActivePabsTarget AT  %VD128   :DINT  ;  (*Destino usado por la unica instruccion PABS*)
    Status_PosActual AT  %VD200   :DINT  ;  (*MODBUS 40101-40102 copia de SMD212*)
    PabsMinF AT  %VW108   :WORD  ;  (*MODBUS 40055 frecuencia minima PABS*)
    PabsTime AT  %VW110   :WORD  ;  (*MODBUS 40056 aceleracion desaceleracion*)
    Status_Word AT  %VW302   :WORD  ;  (*MODBUS 40152 estado del ciclo*)
    StartOutPulse AT  %M0.4    :BOOL  ;  (*Pulso interno PABS ida*)
    StartReturnPulse AT  %M0.5    :BOOL  ;  (*Pulso interno PABS vuelta*)
    WaitDone AT  %M0.6    :BOOL  ;  (*Timer espera 3 segundos terminado*)
    StartPabsPulse AT  %M0.7    :BOOL  ;  (*Pulso comun de la unica instruccion PABS*)
    CycleActive AT  %M1.0    :BOOL  ;  (*Ciclo activo habilita driver*)
    MoveOutActive AT  %M1.1    :BOOL  ;  (*PABS ida activo*)
    WaitReturnActive AT  %M1.2    :BOOL  ;  (*Esperando antes de volver a cero*)
    ReturnActive AT  %M1.3    :BOOL  ;  (*PABS vuelta activo*)
    CycleDone AT  %M1.4    :BOOL  ;  (*Ciclo terminado correctamente*)
    CycleErr AT  %M1.5    :BOOL  ;  (*Ciclo con error*)
    PabsRawDone AT  %M2.0    :BOOL  ;  (*Done bruto de la instruccion PABS*)
    PabsRawErr AT  %M2.1    :BOOL  ;  (*Error bruto de la instruccion PABS*)
    PabsOutDone AT  %M2.2    :BOOL  ;  (*Done latcheado de ida*)
    PabsOutErr AT  %M2.3    :BOOL  ;  (*Error latcheado de ida*)
    PabsReturnDone AT  %M3.1    :BOOL  ;  (*Done latcheado de vuelta*)
    PabsReturnErr AT  %M3.2    :BOOL  ;  (*Error latcheado de vuelta*)
    Hw_DrvEnable AT  %Q0.3    :BOOL  ;  (*Enable driver activo solo durante el ciclo*)
    Status_CycleActive AT  %V302.0  :BOOL  ;  (*Estado bit 0 CycleActive*)
    Status_MoveOutActive AT  %V302.1  :BOOL  ;  (*Estado bit 1 MoveOutActive*)
    Status_WaitReturnActive AT  %V302.2  :BOOL  ;  (*Estado bit 2 WaitReturnActive*)
    Status_ReturnActive AT  %V302.3  :BOOL  ;  (*Estado bit 3 ReturnActive*)
    Status_CycleDone AT  %V302.4  :BOOL  ;  (*Estado bit 4 CycleDone*)
    Status_CycleErr AT  %V302.5  :BOOL  ;  (*Estado bit 5 CycleErr*)
    Status_PabsOutDone AT  %V302.6  :BOOL  ;  (*Estado bit 6 PabsOutDone*)
    Status_PabsOutErr AT  %V302.7  :BOOL  ;  (*Estado bit 7 PabsOutErr*)
    Status_PabsReturnDone AT  %V303.0  :BOOL  ;  (*Estado bit 8 PabsReturnDone*)
    Status_PabsReturnErr AT  %V303.1  :BOOL  ;  (*Estado bit 9 PabsReturnErr*)
    Status_EnableOut AT  %V303.2  :BOOL  ;  (*Estado bit 10 EnableOut*)
    Status_WaitDone AT  %V303.3  :BOOL  ;  (*Estado bit 11 WaitDone*)
END_VAR
VAR_GLOBAL
    T0     :TON   ;  (*  *)
END_VAR