    M2_PrelError_Word AT  %VW606   :WORD  ;  (*MODBUS 40404 error PREL y debug motor 2*)
    M2_HomeStatus_Word AT  %VW608   :WORD  ;  (*MODBUS 40405 estado de HOME motor 2*)
    M2_HomeError_Word AT  %VW610   :WORD  ;  (*MODBUS 40406 error HOME motor 2*)
    M2_JogStatus_Word AT  %VW612   :WORD  ;  (*MODBUS 40407 estado de JOG motor 2*)
    M2_JogError_Word AT  %VW614   :WORD  ;  (*MODBUS 40408 error JOG motor 2*)
END_VAR
