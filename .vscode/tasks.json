{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP-IDF: Build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\scripts\\build.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "ESP-IDF: Clean & Build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\scripts\\build.ps1",
                "-Clean"
            ],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "ESP-IDF: Flash & Monitor",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\scripts\\flash_monitor.ps1",
                "-Port", "${input:serialPort}"
            ]
        },
        {
            "label": "ESP-IDF: Set Target ESP32",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-Command",
                ". '${workspaceFolder}\\scripts\\ensure_idf.ps1'; Import-EspIdfEnvironment; Set-Location '${workspaceFolder}'; idf.py -B build_marti set-target esp32"
            ]
        }
    ],
    "inputs": [
        {
            "id": "serialPort",
            "type": "promptString",
            "description": "Puerto serie (ej: COM4)",
            "default": "COM4"
        }
    ]
}
